{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4318",
        "--directory",
        "design"
      ],
      "port": 4318
    },
    {
      "name": "kompass-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "KOMPASS_DATA=./data-dev",
        "KOMPASS_DRY_SEND=1",
        "KOMPASS_NO_NOTIFY=1",
        "KOMPASS_MOCK_DELAY=600",
        "node",
        "scripts/start.mjs",
        "dev"
      ],
      "port": 4317
    },
    {
      "name": "kompass-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "KOMPASS_DATA=./data-demo",
        "KOMPASS_CLAUDE=mock",
        "KOMPASS_DRY_SEND=1",
        "KOMPASS_NO_NOTIFY=1",
        "KOMPASS_MOCK_DELAY=600",
        "PORT=4319",
        "node",
        "scripts/start.mjs",
        "dev"
      ],
      "port": 4319
    },
    {
      "name": "kompass-prod-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "KOMPASS_DATA=./data-demo",
        "KOMPASS_CLAUDE=mock",
        "KOMPASS_DRY_SEND=1",
        "KOMPASS_NO_NOTIFY=1",
        "KOMPASS_DIST_DIR=.next-test",
        "PORT=4400",
        "node",
        "scripts/start.mjs"
      ],
      "port": 4400
    }
  ]
}